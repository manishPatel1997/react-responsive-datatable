{
  "name": "react-responsive-datatable",
  "version": "1.0.0",
  "description": "The lightest full-featured React data table: search, sort, pagination, server-side mode, and automatic responsive column collapsing. Zero dependencies, zero jQuery, renders live React components in every cell.",
  "type": "module",
  "main": "./dist/lib/index.cjs.js",
  "module": "./dist/lib/index.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.es.js",
      "require": "./dist/lib/index.cjs.js"
    },
    "./styles.css": "./dist/lib/styles.css"
  },
  "files": [
    "dist/lib",
    "dist/types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "dist/lib/styles.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.config.lib.ts",
    "prepublishOnly": "npm run test && npm run build:lib",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^3.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manishPatel1997/react-responsive-datatable.git"
  },
  "homepage": "https://react-responsive-datatable.vercel.app/",
  "bugs": {
    "url": "https://github.com/manishPatel1997/react-responsive-datatable/issues"
  },
  "keywords": [
    "react",
    "table",
    "datatable",
    "data-grid",
    "grid",
    "responsive",
    "sorting",
    "pagination",
    "search",
    "server-side",
    "datatables",
    "nextjs",
    "react-component",
    "priority-collapse",
    "zero-dependency",
    "tailwind",
    "headless"
  ],
  "author": "UDAN",
  "license": "MIT"
}
